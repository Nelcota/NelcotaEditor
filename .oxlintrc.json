{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "react", "unicorn", "oxc", "import", "jsx-a11y"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "rules": {
        // The project uses the automatic JSX runtime (React 17+), so React never needs to be in scope.
        "react/react-in-jsx-scope": "off",
        "no-ternary": "error",
        "no-nested-ternary": "error",
        "no-else-return": "error",
        "no-negated-condition": "error",
        "curly": "error",
        "eqeqeq": "error",
        "no-console": "error",
        "max-params": ["error", { "max": 3 }],
        "max-depth": ["error", { "max": 2 }],
        "typescript/no-explicit-any": "error",
        "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
        "typescript/no-non-null-assertion": "error",
        "typescript/no-floating-promises": ["error", { "ignoreVoid": false }],
        "typescript/no-misused-promises": "error",
        "react/no-array-index-key": "error",
        "react/rules-of-hooks": "error",
        "import/no-cycle": "error",
        "import/no-default-export": "error",
        // The project writes boolean checks out on purpose (`isOpen === true`, see CLAUDE.md), which
        // this rule reports as redundant.
        "typescript/no-unnecessary-boolean-literal-compare": "off",
        // It asks for <output> instead of role="status", but screen readers announce role="status"
        // more reliably, and <progress> or <input type="range"> cannot draw the custom bars and
        // the two-handled trim the Studio needs.
        "jsx-a11y/prefer-tag-over-role": "off"
    },
    "overrides": [
        {
            // Scripts run in a terminal, where printing is their output.
            "files": ["scripts/**"],
            "rules": { "no-console": "off" }
        },
        {
            // node:test's describe/it return promises the runner tracks itself; this goes away when
            // the tests move to Vitest, whose describe/it return nothing.
            "files": ["**/*.test.ts", "**/*.integration.ts"],
            "rules": { "typescript/no-floating-promises": "off" }
        },
        {
            // Clips carry their captions burned into the picture, so they need no captions track.
            "files": ["src/shared/ui/media-player/vertical-clip-player.tsx"],
            "rules": { "jsx-a11y/media-has-caption": "off" }
        },
        {
            // Tools that load these files read their default export.
            "files": ["*.config.ts"],
            "rules": { "import/no-default-export": "off" }
        }
    ],
    "ignorePatterns": [
        "src/routeTree.gen.ts",
        "drizzle/**",
        "storage/**",
        ".output/**",
        // HTML and JS prototypes for design reviews; they never ship.
        "design/**",
        // Third-party skills installed with `npx skills add`; they keep their upstream style.
        ".claude/skills/**"
    ]
}
