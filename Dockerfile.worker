FROM node:24-trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-montserrat fonts-bebas-neue fonts-league-spartan fonts-inter ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Pinned and checked so a build never runs a binary nobody reviewed. YouTube changes often and old
# releases stop working: to update, take a release from https://github.com/yt-dlp/yt-dlp/releases,
# copy the yt-dlp_linux line of its SHA2-256SUMS file into both values and run `npm run services:rebuild`.
ARG YT_DLP_VERSION=2026.10.26
ARG YT_DLP_SHA256=767ba9dce7052aa196f8b12652f433d76de128ba168966fa84b6394d5e6c6795
RUN curl -fsSL -o /usr/local/bin/yt-dlp "https://github.com/yt-dlp/yt-dlp/releases/download/${YT_DLP_VERSION}/yt-dlp_linux" \
    && echo "${YT_DLP_SHA256}  /usr/local/bin/yt-dlp" | sha256sum -c - \
    && chmod +x /usr/local/bin/yt-dlp

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY tsconfig.json ./
COPY src ./src

# The worker runs ffmpeg and yt-dlp on files from the internet; it gets no root rights. The `node`
# user (uid 1000) of the base image owns the storage folder, so a fresh volume is writable too.
RUN mkdir -p /app/storage && chown node:node /app/storage
USER node

CMD ["node", "--import", "tsx", "src/modules/processing/server/worker-main.server.ts"]
