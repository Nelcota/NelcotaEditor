FROM node:24-trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-montserrat fonts-bebas-neue fonts-league-spartan fonts-inter ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# yt-dlp is unpinned on purpose: YouTube changes often and old releases stop working.
# Rebuild the worker image (`npm run services:rebuild`) to update it.
RUN curl -fsSL -o /usr/local/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux \
    && chmod +x /usr/local/bin/yt-dlp

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY tsconfig.json ./
COPY src ./src

# The worker runs ffmpeg and yt-dlp on files from the internet; it gets no root rights. The `node`
# user (uid 1000) of the base image owns the storage folder, so a fresh volume is writable too.
RUN mkdir -p /app/storage && chown node:node /app/storage
USER node

CMD ["node", "--import", "tsx", "src/modules/processing/server/worker-main.server.ts"]
