FROM oven/bun:1.4.5-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-montserrat fonts-bebas-neue fonts-league-spartan fonts-inter ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Pinned and checked so a build never runs a binary nobody reviewed. YouTube changes often and old
# releases stop working: to update, take a release from https://github.com/yt-dlp/yt-dlp/releases,
# copy the yt-dlp_linux line of its SHA2-256SUMS file into both values and run `bun run services:rebuild`.
ARG YT_DLP_VERSION=2026.11.23
ARG YT_DLP_SHA256=249ddb058234276bc449b9cd9492aad9f133bda5923c61a9e39983ae114ef17d
RUN curl -fsSL -o /usr/local/bin/yt-dlp "https://github.com/yt-dlp/yt-dlp/releases/download/${YT_DLP_VERSION}/yt-dlp_linux" \
    && echo "${YT_DLP_SHA256}  /usr/local/bin/yt-dlp" | sha256sum -c - \
    && chmod +x /usr/local/bin/yt-dlp

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts --production

COPY tsconfig.json ./
COPY src ./src
COPY scripts/worker.ts ./scripts/worker.ts

# The worker runs ffmpeg and yt-dlp on files from the internet; it gets no root rights. The `bun`
# user (uid 1000) of the base image owns the storage and work folders, so fresh volumes are
# writable too.
RUN mkdir -p /app/storage /app/work && chown bun:bun /app/storage /app/work
USER bun

CMD ["bun", "scripts/worker.ts"]
