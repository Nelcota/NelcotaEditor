# Copy to .env (bun run setup does it for you and fills BETTER_AUTH_SECRET).

# PostgreSQL running in Docker (docker-compose.yml exposes it on port 5436).
DATABASE_URL="postgresql://nelcota:nelcota@localhost:5436/nelcota"

# Better Auth
BETTER_AUTH_URL="http://localhost:3210"
BETTER_AUTH_SECRET=""
# Production requires BETTER_AUTH_URL to be the real https origin.

# Header your reverse proxy sets to the client's IP (e.g. "cf-connecting-ip", "x-real-ip"), used by
# the sign-in rate limit. Leave empty when the app is reached directly: the connection address is used.
TRUSTED_PROXY_IP_HEADER=""

# Cloudflare Turnstile on sign-up and sign-in (https://dash.cloudflare.com, Turnstile). Set both or
# leave both empty to turn the check off; production (NODE_ENV=production) requires both.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Folder where uploaded videos and rendered clips are stored.
STORAGE_DIR="./storage"

# The worker's scratch folder (downloads, audio, renders before they are stored). Empty uses the
# system temp folder. Each worker needs its own: it is wiped when the worker starts.
WORK_DIR=""

# Where stored files live: "disk" (STORAGE_DIR) or "r2" (a Cloudflare R2 bucket). With r2, set all
# four values below. Use an API token limited to this one bucket, with object read and write only.
STORAGE_DRIVER="disk"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Local Whisper server (speaches, running in Docker).
WHISPER_URL="http://localhost:8000"
# "Systran/faster-whisper-base" is faster but much less accurate in Portuguese.
WHISPER_MODEL="Systran/faster-whisper-small"
# Spoken language of the videos (ISO code). Leave empty to auto-detect.
WHISPER_LANGUAGE="pt"

# DeepSeek picks the best moments of each video. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# Resend sends the sign-up confirmation and password reset emails (only the worker uses it).
# Get a key at https://resend.com/api-keys; the sender's domain must be verified there.
RESEND_API_KEY=""
EMAIL_FROM="Nelcota <nao-responda@tela.nelcota.com>"

# Disk each user may use (GB). The usage screen warns at 80%; new videos are refused once it is full.
STORAGE_QUOTA_GIGABYTES="20"

# YouTube asks datacenter servers to "sign in to confirm you're not a bot". In production, sign in to
# a dedicated Google account (never a personal one: it can be blocked) in a private window, open
# youtube.com, export its cookies in Netscape format, close the window, and put the file here in
# base64 (base64 -w0 cookies.txt). Empty: downloads send no cookies, which works from home networks.
YOUTUBE_COOKIES_BASE64=""
