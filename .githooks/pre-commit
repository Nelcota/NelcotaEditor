#!/bin/sh
# Format, lint, types and copy rules must pass before a commit (see `bun run check`).
# Unformatted code reached git twice when this was only a written rule.
bun run --silent check || {
    echo ""
    echo "pre-commit: bun run check failed. Run \`bun run format\` for formatting, fix the rest, then commit again."
    exit 1
}
