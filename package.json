{
    "name": "nelcota-editor",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "setup": "tsx scripts/setup.ts",
        "dev": "vite dev",
        "build": "vite build",
        "start": "node .output/server/index.mjs",
        "services:up": "docker compose up -d",
        "services:down": "docker compose down",
        "services:rebuild": "docker compose up -d --build worker",
        "worker:restart": "docker compose up -d --force-recreate worker",
        "worker:logs": "docker compose logs -f worker",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt",
        "lint": "oxlint"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.108.1",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.7",
        "@tanstack/react-table": "^9.3.1",
        "better-auth": "^1.5.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cn": "^0.5.2",
        "drizzle-kit": "^0.31.9",
        "drizzle-orm": "^0.45.1",
        "execa": "^10.2.1",
        "nitro": "3.0.260610-beta",
        "openai": "^7.61.0",
        "pg": "^8.16.3",
        "pg-boss": "^12.38.2",
        "radix-ui": "^1.8.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "recharts": "^3.11.0",
        "tailwind-merge": "^3.0.2",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.3.6",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@iconify-json/solar": "^1.2.16",
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.15.6",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "dotenv": "^17.3.1",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.0.0"
    }
}
