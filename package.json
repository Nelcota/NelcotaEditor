{
    "name": "nelcota-editor",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "setup": "bun scripts/setup.ts",
        "local": "bun scripts/run-local.ts",
        "dev": "bunx --bun vite dev",
        "build": "bunx --bun vite build",
        "start": "bun .output/server/index.mjs",
        "services:up": "docker compose up -d",
        "services:down": "docker compose down",
        "services:rebuild": "docker compose up -d --build worker",
        "worker:restart": "docker compose up -d --force-recreate worker",
        "worker:logs": "docker compose logs -f worker",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "admin:grant": "bun scripts/grant-admin.ts",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint --type-aware",
        "check:copy": "bun scripts/check-copy-dashes.ts",
        "check:boundaries": "bun scripts/check-module-boundaries.ts",
        "test": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:e2e": "playwright test",
        "check": "oxfmt --check && oxlint --type-aware && tsc --noEmit && bun scripts/check-copy-dashes.ts && bun scripts/check-module-boundaries.ts && vitest run --project unit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1176.0",
        "@aws-sdk/s3-request-presigner": "3.1176.0",
        "@date-fns/tz": "^1.5.0",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.108.1",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.7",
        "@tanstack/react-table": "^9.3.1",
        "better-auth": "^1.5.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "drizzle-kit": "^0.31.9",
        "drizzle-orm": "^0.45.1",
        "execa": "^10.2.1",
        "image-size": "^2.1.0",
        "nitro": "3.0.260610-beta",
        "openai": "^7.61.0",
        "pg": "^8.16.3",
        "pg-boss": "^12.38.2",
        "pino": "10.4.0",
        "radix-ui": "^1.8.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "recharts": "^3.11.0",
        "tailwind-merge": "^3.0.2",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.3.6",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@babel/core": "7.29.13",
        "@iconify-json/lucide": "^1.2.158",
        "@playwright/test": "1.65.1",
        "@rolldown/plugin-babel": "0.3.1",
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.13",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.15.6",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "babel-plugin-react-compiler": "1.0.0",
        "dotenv": "^17.3.1",
        "happy-dom": "21.0.4",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "oxlint-tsgolint": "7.0.2008",
        "typescript": "^6.0.2",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.0.0",
        "vitest": "5.1.1"
    },
    "packageManager": "bun@1.4.5"
}
